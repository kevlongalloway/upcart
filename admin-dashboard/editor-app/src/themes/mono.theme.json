      "preset": "mono",
      "colors": {
        "primary": "#000000",
        "primaryText": "#ffffff",
        "secondary": "#333333",
        "accent": "#333333",
        "background": "#f9f9f9",
        "surface": "#ffffff",
        "text": "#000000",
        "textMuted": "#555555",
        "border": "#e0e0e0"
      },
      "typography": {
        "headingFont": "Bebas Neue",
        "bodyFont": "Space Mono",
        "baseFontSize": 15,
        "headingWeight": 700,
        "bodyWeight": 400,
        "lineHeight": 1.6,
        "letterSpacing": 0
      },
      "spacing": {
        "containerMaxWidth": 1280,
        "sectionVerticalPadding": 88,
