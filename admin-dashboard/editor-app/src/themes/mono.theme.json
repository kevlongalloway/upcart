{
  "id": "mono",
  "name": "Mono",
  "description": "High-contrast monochrome — condensed Bebas Neue headlines over Space Mono. Sharp, confident, zero radius.",
  "themeVersion": "1.0.0",
  "engineVersion": "2.0",
  "author": "Upcart",
  "price": 0,
