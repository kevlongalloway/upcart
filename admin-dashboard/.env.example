# Copy to `.env` for local development, or set these in your hosting provider
# (e.g. Render → Environment) for production deploys.
# `.env` is gitignored and never committed.

# Port the Express dev server binds to.
PORT=3000

# Full URL of the backend Cloudflare Worker API (no trailing slash).
# The dashboard reads this via `GET /config`.
# Example:
#   WORKER_URL=https://my-store.workers.dev
WORKER_URL=https://<your-worker>.workers.dev
