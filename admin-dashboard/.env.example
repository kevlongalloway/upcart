# Copy to `.env` for local development, or set these in your hosting provider
# (Render → Environment, Cloudflare Pages build vars, etc.) for production.
# `.env` is gitignored and never committed.
#
# The dashboard is a single multi-tenant deployment at dashboard.upcart.online.
# It does NOT talk to any specific merchant worker directly — after a merchant
# logs in via the provisioning service, the SPA stores that merchant's worker
# URL in sessionStorage and calls it from the browser.

PORT=3000

# URL of the provisioning service — exposes POST /auth/login.
# The dashboard calls this to authenticate merchants and discover which
# store worker to talk to for the rest of the session.
PROVISION_URL=https://provision.upcart.online

# Root domain of the platform. Used when the dashboard needs to construct
# store URLs like https://<subdomain>.<BASE_DOMAIN>.
BASE_DOMAIN=upcart.online

# Where the "Don't have a store? Sign up" link points.
# Usually the landing page on the root domain.
SIGNUP_URL=https://upcart.online
