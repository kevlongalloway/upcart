# Copy to `.env` for local development, or set these in your hosting provider
# (e.g. Render → Environment) for production deploys.
# `.env` is gitignored and never committed.
#
# The customer store is a static site. At build time, `build.sh` reads these
# vars and writes them into `config.js` (which is loaded by every HTML page).

# Full URL of the backend Cloudflare Worker API (no trailing slash).
# Example:
#   API_BASE_URL=https://my-store.workers.dev
API_BASE_URL=https://<your-worker>.workers.dev
