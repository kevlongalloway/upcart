{
  "name": "upcart-provisioning-service",
  "version": "1.0.0",
  "private": true,
  "description": "Upcart provisioning service — auto-deploys a store Worker + D1 + R2 for each new merchant sign-up.",
  "scripts": {
    "dev":    "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create":     "wrangler d1 create upcart-provisioning-db",
    "db:migrate":    "wrangler d1 migrations apply upcart-provisioning-db",
    "db:migrate:local": "wrangler d1 migrations apply upcart-provisioning-db --local",
    "r2:create":     "wrangler r2 bucket create upcart-worker-bundles",
    "bundle:build":  "cd ../backend && npm run build",
    "bundle:upload": "npm run bundle:build && wrangler r2 object put upcart-worker-bundles/store-worker.js --file ../backend/dist/index.js"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "@hono/zod-validator": "^0.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
